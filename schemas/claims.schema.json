{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coursestudio.local/schemas/claims/1.0.0",
  "title": "CourseStudio Claim Ledger Entry",
  "description": "Contract v1.0.0. Canonical Claim Ledger v1 has exactly 15 fields. The historical label 'Core 14' is retired; see schemas/README.md for the naming resolution and legacy 8-column mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id", "claim_text", "claim_type", "source_ids", "source_locators",
    "inspection_scope", "scope_limit", "derivation_or_data",
    "evidence_status", "reasoning_status", "execution_status", "validation_status",
    "conflict_status", "used_in_artifact", "review_notes"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
    "claim_text": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["FACT", "CLAIM", "INFERENCE", "ASSUMPTION", "REPRODUCED_RESULT"]},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
      "uniqueItems": true,
      "minItems": 0
    },
    "source_locators": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
          "locator": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string"},
          "url": {"type": "string"}
        }
      }
    },
    "inspection_scope": {"type": "string", "minLength": 1},
    "scope_limit": {"type": "string", "minLength": 1},
    "derivation_or_data": {"type": "string", "minLength": 1},
    "evidence_status": {"enum": ["DIRECTLY_SUPPORTED", "PARTIAL", "UNSUPPORTED", "NOT_CHECKED", "NOT_APPLICABLE"]},
    "reasoning_status": {"enum": ["VALID", "FLAWED", "INCOMPLETE", "NOT_APPLICABLE", "NOT_CHECKED"]},
    "execution_status": {"enum": ["NOT_RUN", "THEORETICAL_ONLY", "EXECUTED", "REPRODUCED", "BLOCKED", "NOT_APPLICABLE"]},
    "validation_status": {"enum": ["PASSED", "FAILED", "PARTIAL", "NOT_RUN", "BLOCKED"]},
    "conflict_status": {"enum": ["NONE", "POTENTIAL_CONFLICT", "CONFIRMED_CONFLICT", "NOT_CHECKED"]},
    "used_in_artifact": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(SEG-[0-9]{3}|SLD-[0-9]{2,}|CUE-[0-9]{3}|REC-[0-9]{3})$"},
      "uniqueItems": true
    },
    "review_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes", "decision"],
      "properties": {
        "notes": {"type": "string"},
        "decision": {"enum": ["PENDING", "ACCEPTED", "REJECTED"]},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"claim_type": {"enum": ["FACT", "CLAIM", "INFERENCE", "REPRODUCED_RESULT"]}}, "required": ["claim_type"]},
      "then": {
        "properties": {
          "source_ids": {"minItems": 1},
          "source_locators": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"claim_type": {"const": "REPRODUCED_RESULT"}}, "required": ["claim_type"]},
      "then": {
        "properties": {
          "execution_status": {"const": "REPRODUCED"},
          "validation_status": {"const": "PASSED"}
        }
      }
    }
  ]
}
