{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coursestudio.local/schemas/segments/1.0.0",
  "title": "CourseStudio Segment Manifest",
  "description": "Contract v1.0.0. Segments are the single source of truth for animation engine, order, declared duration, script anchors, scene/project mapping, and verification source. Runtime-derived durations must never overwrite declared durations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "episode_id", "canvas", "segments"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "episode_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080},
        "fps": {"const": 60}
      }
    },
    "segments": {
      "type": "array",
      "items": {"$ref": "#/$defs/segment"}
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id", "name", "order", "engine", "duration_seconds",
        "declared_seconds", "actual_seconds", "actual_source",
        "script_anchor", "slide_anchors", "scene", "project", "cue", "record_status"
      ],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^SEG-[0-9]{3}$"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "order": {"type": "integer", "minimum": 1},
        "engine": {"enum": ["motion", "manim"]},
        "duration_seconds": {"type": "number", "minimum": 0.1},
        "declared_seconds": {"type": "number", "minimum": 0.1},
        "actual_seconds": {"type": ["number", "null"]},
        "actual_source": {"enum": ["probe", "ffprobe", "recording", "NOT_VERIFIED"]},
        "script_anchor": {"type": "string", "pattern": "^\\[ANIMATION:\\s*[A-Za-z0-9_-]+\\]$"},
        "slide_anchors": {
          "type": "array",
          "items": {"type": "string", "pattern": "^SLD-[0-9]{2,}$"},
          "uniqueItems": true
        },
        "scene": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "cue": {"type": "string", "pattern": "^05_recording/cues/.+\\.md$"},
        "record_status": {"enum": ["NOT_RUN", "IN_PROGRESS", "RECORDED_UNVERIFIED", "VERIFIED", "REJECTED"]},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"engine": {"const": "motion"}}, "required": ["engine"]},
          "then": {"properties": {"duration_seconds": {"minimum": 45, "maximum": 90}, "declared_seconds": {"minimum": 45, "maximum": 90}}}
        },
        {
          "if": {"properties": {"engine": {"const": "manim"}}, "required": ["engine"]},
          "then": {"properties": {"duration_seconds": {"minimum": 0.1, "maximum": 20}, "declared_seconds": {"minimum": 0.1, "maximum": 20}}}
        },
        {
          "if": {"properties": {"actual_source": {"enum": ["probe", "ffprobe", "recording"]}}, "required": ["actual_source"]},
          "then": {"properties": {"actual_seconds": {"type": "number", "minimum": 0.1}}}
        },
        {
          "if": {"properties": {"actual_source": {"const": "NOT_VERIFIED"}}, "required": ["actual_source"]},
          "then": {"properties": {"actual_seconds": {"type": "null"}}}
        }
      ]
    }
  }
}
