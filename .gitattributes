# Normalize line endings across platforms.
* text=auto

# Source and docs: LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.lock text eol=lf
uv.lock text eol=lf
pnpm-lock.yaml text eol=lf
tools/paper-search-mcp/bin/paper-search text eol=lf

# Windows scripts: CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.zip binary
