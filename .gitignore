# --- 日志与归档 -------------------------------------------------------------
*.log
# Course QA evidence logs are intentional, not transient logs.
!courses/**/qa/runtime/*.log
!courses/**/qa/runs/**/*.log
!courses/**/qa/*.log
logs/
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# --- 嵌套仓库 ---------------------------------------------------------------
# 根仓库已忽略 /courses/* 与 /labs/；课程/实验在各自目录 git init。
# tools/paper-search-mcp 是外部仓库；若要在根仓库跟踪，请改为 submodule，
# 不要直接嵌入其 .git（否则 Git 只记录 gitlink）。
# /tools/paper-search-mcp/
